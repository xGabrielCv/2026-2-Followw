# Copie para deploy/production.env (ignorado pelo Git) e preencha. Gere cada segredo com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nunca versione o arquivo preenchido.

PUBLIC_HOST=followw.exemplo.com.br
# Quem pode abrir /api/admin (IPs ou CIDRs separados por espaço). OBRIGATÓRIO: coloque só o seu IP.
# O padrão abaixo bloqueia o painel para todo mundo, exceto a própria máquina.
ADMIN_ALLOWED_IPS=127.0.0.1

# Conta de manutenção do PostgreSQL (só o serviço `migrate` e as cópias de segurança usam).
POSTGRES_PASSWORD=
# Senha do papel restrito followw_app (a API usa; sem bypass de Row-Level Security).
APP_DB_PASSWORD=

# Cookies cifrados. Trocar invalida as sessões.
JWT_SECRET_KEY=
# Cifra do conteúdo da comunidade e dos arquivos. SEM esta chave o conteúdo cifrado não volta:
# guarde cópia fora da VPS. Para girar a chave, veja `data-keys` e DATA_ENCRYPTION_KEY_ID.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=initial
# Assina o IP do cliente enviado pelo front à API (rate limit).
RATE_LIMIT_SECRET_KEY=

# O cadastro do administrador pela página só existe fora de produção: gere o hash com
#   docker compose -f deploy/compose.production.yml run --rm migrate admin-password
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Pool do PostgreSQL por processo: (DB_POOL_SIZE + DB_MAX_OVERFLOW) x API_WORKERS deve ficar
# abaixo de max_connections (100) menos folga para manutenção.
API_WORKERS=2
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
