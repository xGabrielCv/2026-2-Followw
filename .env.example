# Modelo público: nunca preencha nem versione segredos neste arquivo.
# No Windows, run.ps1 gera apps/api/.env e chaves próprias automaticamente.
ENVIRONMENT=development
JOB_QUEUE=local
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/followw
PUBLIC_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:3000"]
# Defina um valor aleatório com pelo menos 32 caracteres no seu .env privado:
# JWT_SECRET_KEY=<gerar-localmente>
# DATA_ENCRYPTION_KEY=<gerar-localmente-e-guardar-backup>
# Admin: primeiro acesso local em /api/admin ou uv run admin-password.
# ADMIN_USERNAME=<seu-usuario>
# ADMIN_PASSWORD_HASH=<hash-gerado-pelo-comando>
# Redis e telemetria são opcionais; não precisam de configuração para rodar local.
# UPSTASH_REDIS_REST_URL=<sua-url>
# UPSTASH_REDIS_REST_TOKEN=<seu-token>
VITE_POSTHOG_KEY=
